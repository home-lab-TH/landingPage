PORT=3000

# --- Proxmox API (landing-cutover.sh fills these in for you) ---
PROXMOX_URL=https://10.0.0.x:8006/api2/json
PROXMOX_NODE=server
# One token for stats, create and delete (user dashboard@pve: PVEAuditor + PVEVMAdmin + PVEDatastoreUser + PVESDNUser)
PROXMOX_TOKEN_ID=dashboard@pve!main
PROXMOX_TOKEN_SECRET=replace-with-token-secret
# Proxmox uses a self-signed certificate. 1 = accept it (fine on the LAN).
PROXMOX_INSECURE_TLS=1

# --- Create / delete ---
# The one main password for the Create page and the Delete buttons.
DASHBOARD_PASSWORD=choose-a-password
# New containers start from this OS image (pveam list local)
PROXMOX_LXC_OSTEMPLATE=local:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0
# Optional: VMs are cloned from this VM template ID
# PROXMOX_VM_TEMPLATE=9000

# --- Sites page (filled in by homelab-ops/sites-setup.sh) ---
PROXY_AGENT_URL=http://10.0.0.250:8091
PROXY_AGENT_TOKEN=
SITE_AGENT_URL=http://10.0.0.226:8090
SITE_AGENT_TOKEN=
