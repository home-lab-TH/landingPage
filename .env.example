PORT=3000

# --- Live stats (read-only token with the PVEAuditor role) ---
# Proxmox API URL as seen from FrontPage. Keep /api2/json at the end.
PROXMOX_URL=https://10.0.0.138:8006/api2/json
PROXMOX_NODE=server
PROXMOX_READ_TOKEN_ID=dashboard@pve!read
PROXMOX_READ_TOKEN_SECRET=replace-with-read-token-secret
# Proxmox uses a self-signed certificate. 1 = accept it (fine on the LAN).
PROXMOX_INSECURE_TLS=1

# --- Optional: "Create" page (token that may clone templates) ---
PROXMOX_TOKEN_ID=dashboard@pve!provisioner
PROXMOX_TOKEN_SECRET=replace-with-provisioning-token-secret
PROXMOX_VM_TEMPLATE=9000
PROXMOX_LXC_TEMPLATE=9001
# Required to enable the Create page. Anyone who knows it can create VMs/LXCs.
PROVISION_PASSWORD=choose-a-long-random-password
