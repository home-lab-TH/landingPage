# Your Tailscale-reachable Proxmox API URL. Keep /api2/json at the end.
PROXMOX_URL=https://proxmox.tailnet-name.ts.net:8006/api2/json
PROXMOX_TOKEN_ID=dashboard@pve!provisioner
PROXMOX_TOKEN_SECRET=replace-with-your-token-secret
PROXMOX_NODE=pve
# Numeric VMID of the prepared source templates to clone.
PROXMOX_VM_TEMPLATE=9000
PROXMOX_LXC_TEMPLATE=9001

# Required to enable the Provision page. Anyone who knows it can create VMs/LXCs.
PROVISION_PASSWORD=choose-a-long-random-password
